table 'analytics fact_order_items'
	lineageTag: e371569a-a4b6-4e25-ad37-39b951bb84e3

	measure 'Total GMV' = ```
			
			CALCULATE(
			    SUM('analytics fact_order_items'[price]),
			    'analytics fact_orders'[order_status] = "delivered"
			)
			
			```
		lineageTag: fd9e6a31-62b1-4eab-950c-0e2072f626d2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Freight' = ```
			
			CALCULATE(
			    SUM('analytics fact_order_items'[freight_value]),
			    'analytics fact_orders'[order_status] = "delivered"
			)
			
			```
		lineageTag: 88a654d8-adc4-47f7-b401-d7702899b4b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Items Sold' =
			
			CALCULATE(
			    COUNTROWS('analytics fact_order_items'),
			    'analytics fact_orders'[order_status] = "delivered"
			)
		formatString: 0
		lineageTag: 6137e5c5-9b13-48e4-83ef-5de806dd628c

