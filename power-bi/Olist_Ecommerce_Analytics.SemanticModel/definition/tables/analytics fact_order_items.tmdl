	column 'price (bins)' =
			IF(
				ISBLANK('analytics fact_order_items'[price]),
				BLANK(),
				IF(
					'analytics fact_order_items'[price] >= 0,
					ROUNDDOWN('analytics fact_order_items'[price] / 50, 0) * 50,
					ROUNDUP('analytics fact_order_items'[price] / 50, 0) * 50
				)
			)
		lineageTag: 623203ea-58fb-45e4-a0f4-de6319891380
		summarizeBy: none

