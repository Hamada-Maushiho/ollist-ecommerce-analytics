table 'analytics fact_orders'
	lineageTag: 2d5835df-8916-488b-9d3e-8621d66fa51c

	measure 'Total Orders' = ```
			
			DISTINCTCOUNT('analytics fact_orders'[order_id])
			
			```
		formatString: 0
		lineageTag: 561fd640-1b7f-452b-8478-2d2475afda48

	measure 'Delivered Orders' = ```
			
			CALCULATE(
			    [Total Orders],
			    'analytics fact_orders'[order_status] = "delivered"
			)
			
			```
		formatString: 0
		lineageTag: 427a6dfa-4ec2-4f01-ac16-412af0cc4557

	measure 'Canceled Orders' = ```
			
			CALCULATE(
			    [Total Orders],
			    'analytics fact_orders'[order_status] = "canceled"
			)
			
			```
		formatString: 0
		lineageTag: 0a3191ec-4f75-4e69-afb5-9495c3c33fe5

	measure 'Unavailable Orders' = ```
			
			CALCULATE(
			    [Total Orders],
			    'analytics fact_orders'[order_status] = "unavailable"
			)
			
			```
		formatString: 0
		lineageTag: d286fc0f-903a-4de2-bca5-49427344a5e9

	measure 'Delivered Rate' = ```
			
			DIVIDE(
			    [Delivered Orders],
			    [Total Orders],
			    0
			)
			
			```
		lineageTag: 8a12152f-8c62-41fb-aa2b-95baee973d7a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'On-Time Delivery Rate' = ```
			
			DIVIDE(
			    CALCULATE(
			        [Total Orders],
			        'analytics fact_orders'[is_on_time] = TRUE()
			    ),
			    [Delivered Orders],
			    0
			)
			
			```
		lineageTag: 7e90c19f-fbc0-4633-ab50-7c471d510e6e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Delivery Days' =
			
			CALCULATE(
			    AVERAGE('analytics fact_orders'[delivery_days]),
			    'analytics fact_orders'[order_status] = "delivered"
			)
		lineageTag: e3374ff8-893b-40a5-a7a7-362818a491c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Delivery Delay' =
			
			CALCULATE(
			    AVERAGE('analytics fact_orders'[delivery_delay_days]),
			    'analytics fact_orders'[order_status] = "delivered"
			)
		lineageTag: a728201d-99b8-4192-b125-4f8ebd1ce9ea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

