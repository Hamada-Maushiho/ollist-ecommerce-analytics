	column 'delivery_delay_days (bins)' =
			IF(
				ISBLANK('analytics fact_orders'[delivery_delay_days]),
				BLANK(),
				INT('analytics fact_orders'[delivery_delay_days] / 5) * 5
			)
		formatString: 0
